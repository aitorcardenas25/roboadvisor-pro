# ──────────────────────────────────────────────────────────────────────────────
# FACTOR OTC — Variables d'entorn
# Copia aquest fitxer a .env.local i omple els valors reals.
# IMPORTANT: Mai commetis .env.local al repositori.
# ──────────────────────────────────────────────────────────────────────────────


# ── Autenticació (OBLIGATORI) ──────────────────────────────────────────────────

# Clau secreta per a sessions JWT de NextAuth. Genera-la amb:
#   openssl rand -base64 32
NEXTAUTH_SECRET=canvia-aixo-per-un-secret-fort

# URL base de l'aplicació (sense barra al final)
NEXTAUTH_URL=http://localhost:3000

# Clau addicional per a JWT intern (pot ser la mateixa que NEXTAUTH_SECRET)
JWT_SECRET=canvia-aixo-per-un-secret-fort


# ── Admin (OBLIGATORI) ────────────────────────────────────────────────────────

# Credencials de l'usuari administrador principal
ADMIN_USERNAME=admin
# Mínim 12 caràcters. Sense aquesta variable (o amb el valor d'exemple) NO hi ha usuari admin.
ADMIN_PASSWORD=canvia-aquesta-contrassenya

# Email de l'admin per rebre notificacions internes
ADMIN_EMAIL=admin@factorotc.com

# Email des del qual s'envien els emails de sistema
# Ha de coincidir amb un domini verificat a Resend
FROM_EMAIL=noreply@factorotc.com


# ── Supabase (RECOMANAT per a producció) ──────────────────────────────────────
# Sense Supabase, l'app funciona en mode in-memory (dades es perden en reiniciar).
# Obtenció: https://supabase.com > Projecte > Settings > API

# URL del projecte Supabase (NO és NEXT_PUBLIC — server-side only)
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Clau de servei (service_role) — MAI exposar al client ni NEXT_PUBLIC
# Té accés total a la BD. Usar NOMÉS al servidor.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...


# ── Financial Modeling Prep (RECOMANAT per a dades reals) ─────────────────────
# Sense FMP, els preus de mercat són simulats.
# Pla gratuït disponible: https://financialmodelingprep.com/developer/docs

FMP_API_KEY=


# ── Alpha Vantage (OPCIONAL — fallback de FMP) ────────────────────────────────
# 500 peticions/dia gratuïtes: https://www.alphavantage.co/support/#api-key

ALPHA_VANTAGE_API_KEY=


# ── Resend (RECOMANAT per a emails) ───────────────────────────────────────────
# Sense Resend, els emails es registren per consola però no s'envien.
# Pla gratuït disponible: https://resend.com

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ── Stripe (OPCIONAL — per a pagaments) ───────────────────────────────────────
# Si no es configura, el checkout retorna 503.
# Documentació: https://stripe.com/docs/keys

# Clau secreta de Stripe (sk_live_... per producció, sk_test_... per dev)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Secret del webhook (Stripe Dashboard > Webhooks > Signing secret)
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# IDs dels preus de Stripe (crear a Stripe Dashboard > Products)
STRIPE_PRICE_INITIAL_REPORT=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_MONTHLY_SUB=price_xxxxxxxxxxxxxxxxxxxx


# ── Usuaris clients addicionals (OPCIONAL) ────────────────────────────────────
# JSON array d'usuaris autoritzats. Alternativa a Supabase per a entorns simples.
# AUTHORIZED_USERS=[{"username":"client1","password":"pass1","name":"Joan","email":"joan@exemple.com","role":"client","active":true,"subscriptionPlan":"active","subscriptionStatus":"active"}]
AUTHORIZED_USERS=


# ── Frankfurter (OPCIONAL — conversió de divises, sense API key) ───────────────
# API gratuïta per a tipus de canvi EUR/USD/GBP/CHF. No requereix API key.
# S'utilitza per mostrar actius en USD convertits a EUR a les carteres de clients.
# Documentació: https://api.frankfurter.app/docs
# No cal afegir cap variable d'entorn — funciona de forma automàtica.

# ── Recomanacions personalitzades (regulatori) ───────────────────────────────
# Cartera amb fons concrets (ISIN), senyals Comprar/Vendre, informe borsari amb
# recomanació i informe inicial de pagament. Poden constituir assessorament
# d'inversió (MiFID II). Activades per defecte (decisió 2026-11-06); posar a
# false abans d'obrir l'app a clients si l'advocat ho recomana.
NEXT_PUBLIC_ENABLE_RECOMMENDATIONS=true
